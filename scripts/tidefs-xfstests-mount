#!/usr/bin/env bash
# tidefs-xfstests-mount — TideFS FUSE mount helper for xfstests
#
# xfstests calls this as: tidefs-preview <mountpoint> -o <options>
# (via mount.fuse which looks for TEST_DEV on PATH)
#
# The wrapper creates one regular-file pool device per xfstests device name,
# launches the canonical tidefsctl pool mount carrier, and waits for the
# mountpoint to become ready.
set -euo pipefail

die() { echo "tidefs-xfstests-mount: $*" >&2; exit 1; }
debug() { [ "${TIDEFS_XFSTESTS_DEBUG:-0}" = "1" ] && echo "[tidefs-xfstests-mount] $*" >&2; return 0; }

# When called via mount(8): mount.fuse <device> <mountpoint> [-o opts]
# When called directly:      tidefs-preview <mountpoint> [-o opts]
# Detect calling convention by checking if $2 looks like a path.
if [ "$#" -ge 2 ] && [ "${2:0:1}" = "/" ]; then
    device="$1"
    mountpoint="$2"
    shift 2
else
    [ "$#" -ge 1 ] || die "usage: mount.fuse <device> <mountpoint> [-o <options>]"
    device="tidefs-preview"
    mountpoint="$1"
    shift
fi

while [ "$#" -gt 0 ]; do
    case "$1" in
        -o) [ "$#" -ge 2 ] || die "-o requires an argument"; mount_opts="$2"; shift 2 ;;
        --help|-h) echo "TideFS FUSE mount helper for xfstests" >&2; exit 0 ;;
        *) shift ;;
    esac
done

mount_options="${TIDEFS_XFSTESTS_MOUNT_OPTIONS:-relatime,dev}"
mount_read_only=()
if [ -n "${mount_opts:-}" ]; then
    old_ifs="$IFS"
    IFS=,
    for opt in $mount_opts; do
        case "$opt" in
            atime|strictatime|relatime|noatime)
                mount_options="$opt"
                ;;
            nodiratime|diratime)
                mount_options="$mount_options,$opt"
                ;;
            sync|async|allow_other|noallow_other|dev|nodev)
                mount_options="$mount_options,$opt"
                ;;
            ro)
                mount_read_only=(--read-only)
                ;;
            rw)
                mount_read_only=()
                ;;
        esac
    done
    IFS="$old_ifs"
fi

store_root="${TIDEFS_XFSTESTS_STORE_ROOT:-/tmp/tidefs-xfstests-store}"
mkdir -p "$store_root"

mount_tag="$(echo "$device" | tr -dc 'a-zA-Z0-9._-' | head -c 32)"
[ -n "$mount_tag" ] || mount_tag="tidefs"
store_dir="$store_root/xfstests-${mount_tag}"
mkdir -p "$store_dir"

tidefsctl_bin="${TIDEFSCTL_BIN:-}"
[ -n "$tidefsctl_bin" ] || tidefsctl_bin="$(command -v tidefsctl 2>/dev/null || true)"
[ -n "$tidefsctl_bin" ] && [ -x "$tidefsctl_bin" ] || die "tidefsctl not found (set TIDEFSCTL_BIN)"

pool_name="xfstests-${mount_tag}"
pool_device="$store_dir/device0.tidefs"
log_file="$store_dir/mount.log"
pid_file="$store_dir/mount.pid"
device_size_bytes="${TIDEFS_XFSTESTS_DEVICE_SIZE_BYTES:-2147483648}"
case "$device_size_bytes" in
    ""|*[!0-9]*) die "TIDEFS_XFSTESTS_DEVICE_SIZE_BYTES must be a positive integer" ;;
esac
[ "$device_size_bytes" -gt 0 ] || die "TIDEFS_XFSTESTS_DEVICE_SIZE_BYTES must be greater than zero"

debug "mountpoint=$mountpoint pool=$pool_name device=$pool_device tidefsctl=$tidefsctl_bin"
debug "mount_options=$mount_options"

[ -c /dev/fuse ] || modprobe fuse 2>/dev/null || true


# Resolve the root-authentication environment. The sanitised environment from mount(8) may strip
# TIDEFS_ROOT_AUTHENTICATION_KEY_HEX, so we also check a key file
# (env TIDEFS_ROOT_AUTH_KEY_FILE or /var/lib/tidefs/root-auth-key).
_auth_key_file="${TIDEFS_ROOT_AUTH_KEY_FILE:-/var/lib/tidefs/root-auth-key}"
if [ -z "${TIDEFS_ROOT_AUTHENTICATION_KEY_HEX:-}" ] && [ -f "$_auth_key_file" ] && [ -r "$_auth_key_file" ]; then
    TIDEFS_ROOT_AUTHENTICATION_KEY_HEX="$(head -c 64 "$_auth_key_file")"
fi
[ -n "${TIDEFS_ROOT_AUTHENTICATION_KEY_HEX:-}" ] || die "root authentication key not found (set TIDEFS_ROOT_AUTHENTICATION_KEY_HEX or TIDEFS_ROOT_AUTH_KEY_FILE)"
export TIDEFS_ROOT_AUTHENTICATION_KEY_HEX

if [ ! -f "$pool_device" ]; then
    truncate -s "$device_size_bytes" "$pool_device"
    if ! "$tidefsctl_bin" pool create "$pool_name" --file-devices --devices "$pool_device" >>"$log_file" 2>&1; then
        rm -f "$pool_device"
        tail -20 "$log_file" 2>/dev/null >&2 || true
        die "tidefsctl pool create failed"
    fi
fi

# Canonical pool lifecycle mount (via run_mount/fuser::mount2), backgrounded
# so mount.fuse can return after readiness.
"$tidefsctl_bin" pool mount "$pool_name" "$mountpoint" \
    --devices "$pool_device" \
    --fs-name "$device" \
    --options "$mount_options" \
    "${mount_read_only[@]}" \
    &>"$log_file" &
mount_pid=$!
echo "$mount_pid" > "$pid_file"

# Wait for mountpoint (poll up to 30s)
for waited in $(seq 30); do
    if mountpoint -q "$mountpoint" 2>/dev/null; then
        debug "mountpoint ready after ${waited}s"
        disown "$mount_pid" 2>/dev/null || true
        exit 0
    fi
    kill -0 "$mount_pid" 2>/dev/null || { tail -20 "$log_file" 2>/dev/null >&2; die "tidefsctl mount owner exited before mount became ready"; }
    sleep 1
done

mount_cmd="$(tr '\0' ' ' <"/proc/$mount_pid/cmdline" 2>/dev/null || true)"
case "$mount_cmd" in
    *"$tidefsctl_bin pool mount $pool_name $mountpoint "*) kill "$mount_pid" 2>/dev/null || true ;;
esac
die "timeout waiting for mountpoint $mountpoint"
